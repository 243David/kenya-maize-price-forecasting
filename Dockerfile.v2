FROM python:3.11-slim
WORKDIR /app
COPY requirements-api-v2.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY api_v2 ./api_v2
COPY reports/advanced/metrics.json /app/reports/advanced/metrics.json
EXPOSE 8000
CMD ["uvicorn", "api_v2.main:app", "--host", "0.0.0.0", "--port", "8000"]
